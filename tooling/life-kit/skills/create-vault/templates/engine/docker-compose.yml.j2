# {{ project_name }} — engine ({{ persona }}). Tier 1.
# Portable: host paths live in .env (${WORKSPACE}); moving to another server means changing .env, no code.
services:
  api:
    build: ./backend
    env_file: .env
    environment:
      DATABASE_URL: ${DATABASE_URL}
    volumes:
      - ${WORKSPACE}/vault:/workspace/vault:ro
    ports:
      - "${API_PORT:-8000}:8000"
{% if scope == 'personal' %}
    networks:
      - personal-net
    # No db service: uses shared Postgres 'personal-db' on the 'personal-net' network.

networks:
  personal-net:
    external: true
{% else %}
    depends_on:
      - db
    networks:
      - {{ db_name }}-net

  db:
    image: postgres:16
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - {{ db_name }}-data:/var/lib/postgresql/data
    networks:
      - {{ db_name }}-net

volumes:
  {{ db_name }}-data:

networks:
  {{ db_name }}-net:
{% endif %}
